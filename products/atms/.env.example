# The local training service runs without this file. The launch commands read
# environment variables from the shell / process manager, not from this file.
ATMS_MODE=training
ATMS_HOST=127.0.0.1
ATMS_PORT=4432

# Integrated live service (main Corridor Communicator process):
# ATMS_ENABLED=true
# ATMS_AGENCY=YOUR-AGENCY
# ATMS_DB_PATH=/persistent-volume/atms-live.sqlite
# JWT_SECRET=<independently generated secret, at least 32 characters>
# ATMS_OPERATOR_USERS=operator1@example.gov,operator2@example.gov
# ATMS_SUPERVISOR_USERS=supervisor@example.gov
# ATMS_VIEWER_USERS=observer@example.gov

# Standalone live service: ATMS_MODE=live, persistent ATMS_DB_PATH,
# ATMS_AGENCY, and ATMS_JWT_SECRET are required. Individual JWTs come from
# your identity service; membership and roles still use the explicit allowlists.
# ATMS_SOURCE_URL=https://your-corridor-communicator.example.gov

# Optional commissioned agency control gateway:
# ATMS_GATEWAY_URL=https://agency-gateway.example.gov/commands
# ATMS_GATEWAY_SECRET=<different independently generated 32+ character secret>
# DTCD closure push (products/atms/DTCD.md): the secret DTCD returns when the ATMS is registered
# ATMS_DTCD_WEBHOOK_SECRET=<feed_webhooks.secret from DTCD, 64 hex characters>
# ATMS_DEVICE_CONFIG=/secure-config/devices.json

# Optional frontend build-time basemap overrides:
# VITE_ATMS_TILE_URL=https://your-licensed-map.example.gov/tile/{z}/{y}/{x}
# VITE_ATMS_TILE_ATTRIBUTION=Your agency / licensed basemap attribution

# Optional agency geometry catalog (continuous GeoJSON LineString segments):
# ATMS_ROAD_NETWORK_PATH=/secure-config/agency-corridor-roads.geojson
# ATMS_ROAD_NETWORK_SOURCE=Agency GIS dataset URL, edition/date, and attribution
# See GEOMETRY.md. Training defaults to a clearly synthetic catalog.

# Live-only optional public read route; requires explicit agency authorization.
# ATMS_PUBLIC_FEED_ENABLED=true
# See FEEDS.md. Default access remains individual JWT authentication.
